            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <meta-data android:name="itc.url" android:value="https://itcpartner.store/apps/crm/"/>
        </activity-alias>
        <activity-alias android:name=".A_fil" android:targetActivity=".AppShortcutActivity" android:enabled="false" android:exported="true"
